rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각자 자기 기록(saves/{내 uid})만 읽고 쓸 수 있어요.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is map;
    }

    // 랭킹: 로그인한 사람은 누구나 볼 수 있고, 자기 줄(ranks/{내 uid})만 쓸 수 있어요.
    // 값은 게임에서 나올 수 있는 범위만 받아요.
    match /ranks/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'earned', 'dex', 'big', 'bigId', 'deep', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.earned is int
        && request.resource.data.earned >= 0 && request.resource.data.earned <= 100000000000
        && request.resource.data.dex is int
        && request.resource.data.dex >= 0 && request.resource.data.dex <= 223
        && request.resource.data.big is number
        && request.resource.data.big >= 0 && request.resource.data.big <= 40000
        && request.resource.data.bigId is string && request.resource.data.bigId.size() <= 20
        && request.resource.data.deep is int
        && request.resource.data.deep >= 0 && request.resource.data.deep <= 480;
    }
  }
}
